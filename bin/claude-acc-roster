#!/usr/bin/env python3
"""Print every claude-acc-tracked account as one JSON object on stdout.

Standalone: this widget shells out to `claude-acc usage` (and `claude-acc
status` for which account is active) and reshapes the text output into
JSON, since claude-acc has no --json flag for usage.
"""

from __future__ import annotations

import json
import re
import shutil
import subprocess
from pathlib import Path

HEADER_RE = re.compile(r"^(\S+)\s+<([^>]*)>\s*(.*)$")
WINDOW_RE = re.compile(r"^(5h|7d)\s+\[[^\]]*\]\s+(\d+)%\s+resets in (.+)$")
ACTIVE_RE = re.compile(r"Active account:\s*(\S+)")


def find_binary() -> str | None:
    which = shutil.which("claude-acc")
    if which:
        return which
    local = Path.home() / ".claude-switch" / "bin" / "claude-acc"
    return str(local) if local.is_file() else None


def parse_usage(output: str) -> list[dict]:
    accounts: list[dict] = []
    current: dict | None = None
    for raw in output.splitlines():
        line = raw.strip()
        if not line:
            continue
        indent = len(raw) - len(raw.lstrip(" "))
        if indent <= 4:
            m = HEADER_RE.match(line)
            if not m:
                continue
            current = {
                "name": m.group(1),
                "email": m.group(2),
                "plan": re.sub(r"\s+", " ", m.group(3).strip()),
                "active": False,
                "sessionPercent": -1,
                "sessionResetLabel": "",
                "weeklyPercent": -1,
                "weeklyResetLabel": "",
                "error": "",
            }
            accounts.append(current)
            continue
        if current is None:
            continue
        m = WINDOW_RE.match(line)
        if not m:
            current["error"] = line
            continue
        window, pct, reset = m.groups()
        percent = max(0.0, min(1.0, int(pct) / 100.0))
        if window == "5h":
            current["sessionPercent"] = percent
            current["sessionResetLabel"] = reset.strip()
        else:
            current["weeklyPercent"] = percent
            current["weeklyResetLabel"] = reset.strip()
    return accounts


def active_account_name(binary: str) -> str:
    try:
        result = subprocess.run([binary, "status"], capture_output=True, text=True, timeout=10)
    except (subprocess.TimeoutExpired, OSError):
        return ""
    m = ACTIVE_RE.search(result.stdout)
    return m.group(1) if m else ""


def main() -> int:
    binary = find_binary()
    if not binary:
        print(json.dumps({"accounts": [], "error": "claude-acc not found", "binaryMissing": True}))
        return 0

    try:
        result = subprocess.run([binary, "usage"], capture_output=True, text=True, timeout=15)
    except subprocess.TimeoutExpired:
        print(json.dumps({"accounts": [], "error": "claude-acc usage timed out", "binaryMissing": False}))
        return 0

    accounts = parse_usage(result.stdout)
    active_name = active_account_name(binary)
    for account in accounts:
        account["active"] = account["name"] == active_name

    error = "" if accounts else (result.stderr.strip() or "No claude-acc accounts yet.")
    print(json.dumps({"accounts": accounts, "error": error, "binaryMissing": False}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
